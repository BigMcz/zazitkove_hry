# Vzor tajemství pro testovací server. Na serveru jako ~/storyhold/.env s právy 600 (chmod 600 .env).
# Skutečné hodnoty nikdy do repozitáře. Hodnoty se znakem $ (bcrypt hash) dávej do jednoduchých uvozovek '…',
# jinak by je Docker Compose rozložil jako proměnné.

# Heslo databáze (např. openssl rand -hex 24). Platí jen při prvním založení DB.
DB_PASSWORD=

# Správce aplikace na https://test.storyhold.cz/admin
ADMIN_USERNAME=admin
# Silné heslo (např. openssl rand -hex 16)
ADMIN_PASSWORD=

# Basic auth před celým testovacím serverem (Caddy)
BASIC_AUTH_USER=tester
# bcrypt hash hesla: docker compose exec caddy caddy hash-password (nebo docker run --rm -it caddy:2 caddy hash-password)
BASIC_AUTH_HASH=''

# Druhý účet basic auth pro prezentace (posílá se lidem mimo tým)
PRESENTATION_AUTH_USER=ukazka
PRESENTATION_AUTH_HASH=''
